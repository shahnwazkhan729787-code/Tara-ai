# ==============================================================================
# AI CHATBOT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Yahan par aap apni API keys daal sakte hain.
# Note: Aap API keys directly Chatbot UI ke "Settings (⚙️)" me bhi daal sakte hain!

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI API KEY (RECOMMENDED - FREE TIER AVAILABLE)
# ------------------------------------------------------------------------------
# Free Gemini API Key paane ke liye link par jayein:
# 👉 https://aistudio.google.com/app/apikey
# Login karein aur "Create API key" par click karke copy karein.
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. OPENAI API KEY (OPTIONAL)
# ------------------------------------------------------------------------------
# Agar aap OpenAI (GPT-4o, GPT-3.5) use karna chahte hain:
# 👉 https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 3. GROK (xAI) API KEY (OPTIONAL)
# ------------------------------------------------------------------------------
# Agar aap Grok (Grok-2, Grok-Beta) use karna chahte hain:
# 👉 https://console.x.ai/
GROK_API_KEY=your_grok_api_key_here

# ------------------------------------------------------------------------------
# 4. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000

